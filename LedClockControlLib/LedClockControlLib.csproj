<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>

        <AssemblyName>WpfxCustomControls.LedClockControl</AssemblyName>
        <PackageId>WpfxCustomControls.LedClockControl</PackageId>
        <PackageVersion>0.1.0-alpha.2</PackageVersion>
        <Title>LedClockControl</Title>
        <Authors>deeks9000</Authors>
        <Description>LED clock custom control, built entirely in C# with WPFX code-first framework</Description>
        <PackageProjectUrl>https://github.com/deeks9000/WpfxLedClockControl</PackageProjectUrl>
        <RepositoryUrl>https://github.com/deeks9000/WpfxLedClockControl</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>csharp;dotnet;wpf;windows;code-first</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="UserExtensions.Wpfx" Version="0.1.0-alpha.12" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
        <None Include="../LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
